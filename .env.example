# Buy Ghana Lands - Environment Variables Example
# Copy this file to .env and fill in your values

# Database (NeonDB)
DATABASE_URL="postgresql://user:password@host/database?sslmode=require"
DIRECT_URL="postgresql://user:password@host/database?sslmode=require"

# Auth.js
AUTH_SECRET="generate-a-secure-secret-key"
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Google OAuth (optional — leave blank to disable Google sign-in)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Theteller (Payswitch) Payment Gateway
THETELLER_MERCHANT_ID="your_merchant_id"
THETELLER_API_USER="your_api_username"
THETELLER_API_KEY="your_api_key"
THETELLER_PASS_CODE="your_float_pass_code"
THETELLER_BASE_URL="https://test.theteller.net"
THETELLER_CHECKOUT_URL="https://checkout-test.theteller.net"
THETELLER_WEBHOOK_SECRET=""  # Optional shared secret for webhook verification

# Meilisearch
MEILISEARCH_HOST="http://localhost:7700"
MEILISEARCH_API_KEY="your_meilisearch_api_key"

# SMS (mNotify + Hubtel)
MNOTIFY_API_KEY="your_mnotify_api_key"
MNOTIFY_SENDER_ID="BuyGhLands"
HUBTEL_CLIENT_ID="your_hubtel_client_id"
HUBTEL_CLIENT_SECRET="your_hubtel_client_secret"

# Email (SMTP via Nodemailer)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="your_smtp_user"
SMTP_PASS="your_smtp_password"
FROM_EMAIL="noreply@buyghanalands.com"
FROM_NAME="BuyGhanaLands"

# Vercel Blob Storage
BLOB_READ_WRITE_TOKEN="vercel_blob_token"

# Cloudinary (Image/Video Storage)
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"

# Sentry (Error Tracking)
SENTRY_DSN=""

# Firebase Cloud Messaging (Push Notifications)
FCM_SERVER_KEY="your_fcm_server_key"

# Apple Sign-In (Required for iOS App Store)
APPLE_CLIENT_ID="com.buyghanalands.app"
APPLE_TEAM_ID="your_apple_team_id"
APPLE_KEY_ID="your_apple_key_id"
APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour_apple_private_key\n-----END PRIVATE KEY-----"

# Mapbox (Maps)
MAPBOX_ACCESS_TOKEN="pk.your_mapbox_access_token"

# AWS Rekognition (KYC face matching — leave blank to use stub fallback)
AWS_REGION=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""

# Redis (optional — for distributed rate limiting in production)
REDIS_URL=""
